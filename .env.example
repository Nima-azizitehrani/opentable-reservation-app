# Copy this file to ".env" and fill in your own local values.
# Never commit a real .env file — it is listed in .gitignore.

# MySQL connection settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=<redacted>
DB_NAME=opentable_app

# Flask session secret — use a long random string of your own
FLASK_SECRET=<redacted>
